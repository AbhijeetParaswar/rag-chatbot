# ──────────────────────────────────────────────────
# RAG Chatbot — Environment Configuration
# Copy to .env and fill in your values
# ──────────────────────────────────────────────────

# ── App ──────────────────────────────────────────
APP_NAME=rag-chatbot
APP_ENV=development          # development | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=["http://localhost:5173"]

# ── Database ─────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/rag_chatbot.db

# ── ChromaDB ─────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_DOCS=documents
CHROMA_COLLECTION_MEMORIES=memories

# ── Embeddings ───────────────────────────────────
EMBEDDING_PROVIDER=sentence-transformers   # sentence-transformers | gemini
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── LLM ──────────────────────────────────────────
LLM_PROVIDER=gemini           # gemini | groq | openai | anthropic | ollama
LLM_MODEL=gemini-2.0-flash

# Provider API keys (set the one you use)
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ── Chunking ─────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_CHUNKS_PER_PAGE=50

# ── Retrieval ────────────────────────────────────
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.65
RETRIEVAL_USE_MMR=false
RETRIEVAL_MMR_DIVERSITY=0.3
RERANKING_ENABLED=false
RERANKING_MODEL=BAAI/bge-reranker-base
RERANKING_TOP_K=5
DEFAULT_ANSWER_MODE=smart_fallback   # strict | smart_fallback | ask_before_fallback

# ── Memory ───────────────────────────────────────
SHORT_TERM_WINDOW=10
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_TOP_K=3

# ── Rate Limiting ────────────────────────────────
RATE_LIMIT=20/minute
